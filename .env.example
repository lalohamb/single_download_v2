# ============================================================
# Printify POD Storefront — Environment Variables
# Copy this file to .env.local and fill in your values.
# ============================================================

# ------------------------------------------------------------
# SUPABASE — Required at runtime
# Create a project at https://supabase.com
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# Server-only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>

# Required for the admin Stripe setup/switch routes that
# programmatically register webhook URLs via the Supabase
# Management API. Generate at:
# https://supabase.com/dashboard/account/tokens
# Server-only — never prefix with NEXT_PUBLIC_
SUPABASE_ACCESS_TOKEN=<your-supabase-personal-access-token>
SUPABASE_PROJECT_REF=<your-supabase-project-ref>

# ------------------------------------------------------------
# PRINTIFY — Required at runtime
# Find your Shop ID and API token at https://printify.com/app/account/connections
# ------------------------------------------------------------
NEXT_PUBLIC_PRINTIFY_SHOP_ID=<your-printify-shop-id>
PRINTIFY_SHOP_ID=<your-printify-shop-id>

# Server-only Printify API token (used in Supabase Edge Functions)
# Never prefix with NEXT_PUBLIC_
PRINTIFY_API_TOKEN=<your-printify-api-token>

# ------------------------------------------------------------
# STRIPE — Required at runtime
# Find your keys at https://dashboard.stripe.com/apikeys
# ------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_<your-stripe-test-secret-key>
STRIPE_WEBHOOK_SECRET=whsec_<your-stripe-webhook-secret>

# ------------------------------------------------------------
# EMAIL — Optional (Resend)
# Required only if you use the email/broadcast features.
# https://resend.com
# ------------------------------------------------------------
RESEND_API_KEY=re_<your-resend-api-key>
RESEND_WEBHOOK_SECRET=<your-resend-webhook-secret>

# ------------------------------------------------------------
# EMAIL — Optional (MailerLite)
# Required only if you use the MailerLite newsletter integration.
# https://www.mailerlite.com
# ------------------------------------------------------------
MAILER_LITE_API_KEY=<your-mailerlite-api-key>

# ------------------------------------------------------------
# LICENSE — Required at runtime
# Generate a unique secret per deployment:
#   openssl rand -hex 32
# Never reuse across deployments. Never commit to Git.
# ------------------------------------------------------------
LICENSE_HMAC_SECRET=<run: openssl rand -hex 32>

# ------------------------------------------------------------
# SITE — Required at runtime
# ------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------
# MARKETING API — Optional (AI agent / central marketing platform)
# Generate: openssl rand -hex 32
# Used to authenticate read-only requests to /api/marketing
# ------------------------------------------------------------
MARKETING_API_KEY=<run: openssl rand -hex 32>

# ------------------------------------------------------------
# DEPLOYMENT — Optional (VPS/PM2 only)
# Not needed for Vercel or Railway deployments.
# ------------------------------------------------------------
# APP_ROOT=/var/www/your-app
# PM2_APP_NAME=your-app
